#include <iostream>
using namespace std;

const int MAX = 5;
int stack[MAX];
int TOP = -1;

// Function Declarations
void push(int value);
void pop();
void peek();
void display();
bool isEmpty();
bool isFull();

int main()
{
    int choice, value;

    do
    {
        cout << "\n----- STACK MENU -----";
        cout << "\n1. Push";
        cout << "\n2. Pop";
        cout << "\n3. Peek";
        cout << "\n4. Display";
        cout << "\n5. Exit";

        cout << "\nEnter your choice: ";
        cin >> choice;

        switch(choice)
        {
            case 1:
                cout << "Enter value: ";
                cin >> value;
                push(value);
                break;

            case 2:
                pop();
                break;

            case 3:
                peek();
                break;

            case 4:
                display();
                break;

            case 5:
                cout << "Program Ended";
                break;

            default:
                cout << "Invalid Choice";
        }

    } while(choice != 5);

    return 0;
}

// Function Definitions

void push(int value)
{
    if(TOP == MAX - 1){
        cout<<"Stack Overflow";
        return;
    }
    TOP += 1;
    stack[TOP] = value;
    cout<<"Added Successfully";
}

void pop()
{
    if(TOP == -1){
        cout<<"Stack Underflow";
        return;
    }
    cout<<"Popped : "<<stack[TOP];
    TOP -= 1;
}

void peek()
{
    if(TOP == -1){
        cout<<"Stack is Empty";
        return;
    }
    cout<<"Element: "<<stack[TOP];
}

void display()
{   int i;
    if(TOP==-1){
        cout<<"Stack is Empty";
        return;
    }
    cout<<"Elements Are : ";
    for( i = TOP;i>=0;i--){
        cout<<stack[i]<<" ";
    }
}

bool isEmpty()
{
    if(TOP == -1){
        return true;
    }
    return false;
}

bool isFull()
{
    if(TOP == MAX -1){
        return true;
    }
    return false;
}
